{
  "name": "@agent-utils/mcp-builder",
  "version": "0.1.0",
  "description": "Developer-first toolkit for building production-ready Model Context Protocol servers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "mcp-builder": "./dist/cli/index.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./testing": { "types": "./dist/testing/index.d.ts", "import": "./dist/testing/index.js", "require": "./dist/testing/index.cjs" },
    "./middleware": { "types": "./dist/middleware/index.d.ts", "import": "./dist/middleware/index.js", "require": "./dist/middleware/index.cjs" },
    "./openapi": { "types": "./dist/openapi/index.d.ts", "import": "./dist/openapi/index.js", "require": "./dist/openapi/index.cjs" }
  },
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md", "CONTRIBUTING.md"],
  "keywords": ["mcp", "model-context-protocol", "ai", "tools", "agent"],
  "engines": { "node": ">=18.17" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "validate": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "dependencies": { "zod": "^3.24.2" },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7",
    "vitepress": "^1.6.3"
  },
  "repository": { "type": "git", "url": "git+https://github.com/Dheerajprogrammer/agent-utils-mcp-builder.git" },
  "homepage": "https://github.com/Dheerajprogrammer/agent-utils-mcp-builder#readme",
  "bugs": { "url": "https://github.com/Dheerajprogrammer/agent-utils-mcp-builder/issues" }
}
